[ req ]
default_bits = 2048
encrypt_key = no
default_md = sha256
utf8 = yes
string_mask = utf8only
prompt = no
distinguished_name = req_distinguished_name

[ req_distinguished_name ]
countryName = US
stateOrProvinceName = Host
localityName = Local
organizationName = localhost
organizationalUnitName = IT
commonName = localhost ; The primary CN


